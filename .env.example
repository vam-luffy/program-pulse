# ---------- Solami (https://solami.dev -> Dashboard -> API keys) ----------
# One standard API key covers RPC, gRPC (x-token), WebSocket and Mirage.
SOLAMI_API_KEY=

# Yellowstone gRPC endpoint. Region-pin with a prefix: https://fra.grpc.solami.dev, ams., nyc.
SOLAMI_GRPC_ENDPOINT=https://grpc.solami.dev
# Optional: separate gRPC key (defaults to SOLAMI_API_KEY). Sent as `x-token` metadata.
SOLAMI_GRPC_TOKEN=
# RPC used for getSlot (stream lag) and the polling fallback. ?api_key= is appended automatically.
SOLAMI_RPC_URL=https://rpc.solami.dev/sol
# Optional overrides
# SOLAMI_WS_URL=wss://ws.solami.dev/ws/sol
# SOLAMI_API_URL=https://api.solami.dev
# MIRAGE_SUBSCRIPTION_ID=          # reuse a Mirage subscription instead of creating one

# ---------- What to watch ----------
# Comma-separated program IDs. Defaults: Jupiter v6 + Pump.fun. Put your own program here.
PROGRAM_IDS=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4,6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# Optional friendly names: id:Label,id:Label
# PROGRAM_LABELS=YourProgram111...:My Program

# ---------- Source selection ----------
# auto = gRPC -> Mirage -> WebSocket logs -> RPC polling (first that works). Or force one:
# grpc | mirage | ws | rpc | replay
SOURCE=auto
COMMITMENT=confirmed
# gRPC: replay this many slots on first connect so the dashboard warms up instantly (max 3500)
BACKFILL_SLOTS=150
# While on a fallback, retry gRPC every N minutes (picks up a plan upgrade without restart)
GRPC_UPGRADE_INTERVAL_MIN=5
# RPC budget shared by all calls (Solami Free tier = 5 req/s)
RPC_MAX_RPS=4
POLL_INTERVAL_MS=2000
SAMPLE_INTERVAL_MS=4000
SAMPLE_SIZE=10

# ---------- Alerts ----------
# Rules live in alerts.yaml; these env vars override thresholds.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ALERTS_FILE=alerts.yaml
# ALERT_ERROR_RATE_PCT=85
# ALERT_ERROR_RATE_WINDOW_MIN=5
# ALERT_SILENCE_MIN=3
# ALERT_SPIKE_MULTIPLIER=3
# ALERT_SPIKE_BASELINE_MIN=15
# ALERT_COOLDOWN_MIN=10

# ---------- Server ----------
PORT=8787
# REPLAY_SPEED=1
# LOG_LEVEL=info
