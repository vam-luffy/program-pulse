{
  "name": "@program-pulse/watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@triton-one/yellowstone-grpc": "4.0.2",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:replay": "tsx watch src/index.ts --replay --chaos --alerts alerts.demo.yaml",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  }
